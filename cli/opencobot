#!/usr/bin/env python3
"""`opencobot` command shim.

The packaged console script is defined in the repo-root
``pyproject.toml`` (``opencobot = "cli.opencobot_cli:main"``) and is
created by ``pip install -e .``. This shim is the same entry point
for a bare checkout: copy/symlink it onto your PATH, or run it
directly — it just execs ``python -m cli.opencobot_cli`` from the
repo root.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from cli.opencobot_cli import main

if __name__ == "__main__":
    raise SystemExit(main())
